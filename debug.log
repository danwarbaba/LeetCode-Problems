 int[] runningSum(int[] nums) {\\n        int val=0;\\n        for(int i=0;i<nums.length;i++){\\n            val+=nums[i];\\n            nums[i]=val;\\n        }\\n        return nums;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111","title_slug":"running-sum-of-1d-array","has_notes":false,"flag_type":1,"frontend_id":116},{"id":2105413502,"question_id":136,"lang":"java","lang_name":"Java","time":"2\xc2\xa0weeks, 2\xc2\xa0days","timestamp":1786624683,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2105413502/","is_pending":"Not Pending","title":"Single Number","memory":"46.8 MB","code":"class Solution {\\n    public int singleNumber(int[] nums) {\\n        int a=0;\\n        for(int i=0;i<nums.length;i++){\\n            a=a^nums[i];\\n\\n        }\\n        return a;\\n        \\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111","title_slug":"single-number","has_notes":false,"flag_type":1,"frontend_id":115},{"id":2104188437,"question_id":485,"lang":"java","lang_name":"Java","time":"2\xc2\xa0weeks, 3\xc2\xa0days","timestamp":1786539553,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/2104188437/","is_pending":"Not Pending","title":"Max Consecutive Ones","memory":"52.5 MB","code":"class Solution {\\n    public int findMaxConsecutiveOnes(int[] nums) {\\n        int count=0;\\n        int max=0;\\n        for(int i=0;i<nums.length;i++){\\n            if(nums[i]==1){\\n                count++;\\n                max = Math.max(count, max);\\n            }else{\\n                count =0;\\n            }\\n        }\\n        return max;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111","title_slug":"max-consecutive-ones","has_notes":false,"flag_type":1,"frontend_id":114}],"has_next":true,"last_key":""}'
