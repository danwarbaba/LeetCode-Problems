i: nums){\\n            if(i==ele1){\\n                count1++;\\n            }else if(i==ele2){\\n                count2++;\\n            }\\n        }\\n        if(count1>=n)li.add(ele1);\\n        if(count2>=n)li.add(ele2);\\n\\n        return li;\\n    }\\n\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"majority-element-ii","has_notes":false,"flag_type":1,"frontend_id":129},{"id":2118439784,"question_id":118,"lang":"java","lang_name":"Java","time":"5\xc2\xa0days, 6\xc2\xa0hours","timestamp":1787576541,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2118439784/","is_pending":"Not Pending","title":"Pascal\'s Triangle","memory":"43.3 MB","code":"class Solution {\\n    public List<List<Integer>> generate(int numRows) {\\n        List<List<Integer>> res = new ArrayList<>();\\n\\n        for(int i=0;i<numRows;i++){\\n            List<Integer> li = new ArrayList<>();\\n            for(int j=0;j<=i;j++){\\n                if(j==0 || j==i){\\n                    li.add(1);\\n                }else{\\n                    li.add(res.get(i-1).get(j-1)+res.get(i-1).get(j));\\n                }\\n            }\\n            res.add(li);\\n        }\\n        return res;\\n    }\\n}","compare_result":"111111111111111111111111111111","title_slug":"pascals-triangle","has_notes":false,"flag_type":1,"frontend_id":128},{"id":2117435699,"question_id":560,"lang":"java","lang_name":"Java","time":"6\xc2\xa0days, 5\xc2\xa0hours","timestamp":1787494809,"status":10,"status_display":"Accepted","runtime":"24 ms","url":"/submissions/detail/2117435699/","is_pending":"Not Pending","title":"Subarray Sum Equals K","memory":"48.8 MB","code":"class Solution {\\n    public int subarraySum(int[] nums, int k) {\\n        int sum = 0;\\n        int count = 0;\\n\\n        HashMap<Integer, Integer> map = new HashMap<>();\\n        map.put(0, 1);\\n\\n        for (int i = 0; i < nums.length; i++) {\\n            sum += nums[i];\\n\\n            if (map.containsKey(sum - k)) {\\n                count += map.get(sum-k);\\n            }\\n            map.put(sum, map.getOrDefault(sum, 0) + 1);\\n        }\\n\\n        return count;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"subarray-sum-equals-k","has_notes":false,"flag_type":1,"frontend_id":127},{"id":2116322260,"question_id":54,"lang":"java","lang_name":"Java","time":"1\xc2\xa0week","timestamp":1787413833,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2116322260/","is_pending":"Not Pending","title":"Spiral Matrix","memory":"43.2 MB","code":"class Solution {\\n    public List<Integer> spiralOrder(int[][] arr) {\\n        int n = arr.length;\\n        int m=arr[0].length;\\n        int left=0, right=m-1;\\n        int top=0, bottom=n-1;\\n        List<Integer> li = new ArrayList<>();\\n\\n        while(top<=bottom && left <= right){\\n            for(int i=left;i<=right;i++){\\n                li.add(arr[top][i]);\\n            }\\n            top++;\\n            for(int i=top;i<=bottom;i++){\\n                li.add(arr[i][right]);\\n            }\\n            right--;\\n            if(top<=bottom)\\n            for(int i=right;i>=left;i--){\\n                li.add(arr[bottom][i]);\\n            }\\n            bottom--;\\n            if(left<=right)\\n            for(int i=bottom;i>=top;i--){\\n                li.add(arr[i][left]);\\n            }\\n            left++;\\n        }\\n        return li;\\n    }\\n}","compare_result":"111111111111111111111111111","title_slug":"spiral-matrix","has_notes":false,"flag_type":1,"frontend_id":126},{"id":2115076671,"question_id":48,"lang":"java","lang_name":"Java","time":"1\xc2\xa0week, 1\xc2\xa0day","timestamp":1787318430,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2115076671/","is_pending":"Not Pending","title":"Rotate Image","memory":"43.5 MB","code":"class Solution {\\n    public void rotate(int[][] arr) {\\n        int n=arr.length;\\n\\n        for( int i=0;i<n-1;i++){\\n            for(int j=i+1;j<n;j++){\\n                swap(arr, i, j);\\n            }\\n        }\\n\\n        for(int i=0;i<n;i++){\\n            int left=0;\\n            int right=n-1;\\n            while(left<right){\\n                int temp = arr[i][left];\\n                arr[i][left] = arr[i][right];\\n                arr[i][right]=temp;\\n\\n                left++;\\n                right--;\\n            }\\n\\n        }\\n    }\\n\\n    public static void swap(int[][] arr, int i, int j){\\n        int temp=arr[i][j];\\n        arr[i][j]=arr[j][i];\\n        arr[j][i]=temp;\\n    }\\n}","compare_result":"111111111111111111111","title_slug":"rotate-image","has_notes":false,"flag_type":1,"frontend_id":125},{"id":2113965098,"question_id":73,"lang":"java","lang_name":"Java","time":"1\xc2\xa0week, 2\xc2\xa0days","timestamp":1787232351,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2113965098/","is_pending":"Not Pending","title":"Set Matrix Zeroes","memory":"47.7 MB","code":"class Solution {\\n    public void setZeroes(int[][] arr) {\\n        int col0=1;\\n        for(int i=0;i<arr.length;i++){\\n            for(int j=0;j<arr[0].length;j++){\\n                if(arr[i][j]==0){\\n                    arr[i][0]=0;\\n\\n                    if(j!=0)\\n                    arr[0][j]=0;\\n                    else\\n                    col0=0;\\n                }\\n            }\\n        }\\n\\n        for(int i=1;i<arr.length;i++){\\n            for(int j=1;j<arr[0].length;j++){\\n                if(arr[i][j]!=0){\\n                    if(arr[0][j]==0 || arr[i][0]==0){\\n                        arr[i][j]=0;\\n                    }\\n                }\\n            }\\n        }\\n\\n // arr[0][0] \xe2\x86\x92 ROW 0\\nif(arr[0][0] == 0){\\n    for(int j=0; j<arr[0].length; j++){\\n        arr[0][j] = 0;\\n    }\\n}\\n\\n// col0 \xe2\x86\x92 COLUMN 0\\nif(col0 == 0){\\n    for(int i=0; i<arr.length; i++){\\n        arr[i][0] = 0;\\n    }\\n}\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"set-matrix-zeroes","has_notes":false,"flag_type":1,"frontend_id":124},{"id":2112349819,"question_id":31,"lang":"java","lang_name":"Java","time":"1\xc2\xa0week, 3\xc2\xa0days","timestamp":1787122091,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2112349819/","is_pending":"Not Pending","title":"Next Permutation","memory":"44.4 MB","code":"class Solution {\\n    public void nextPermutation(int[] nums) {\\n        int idx=-1;\\n\\n        for(int i=nums.length-2;i>=0;i--){\\n            if(nums[i]<nums[i+1]){\\n                idx=i;\\n                break;\\n            }\\n        }\\n\\n        if(idx==-1){\\n            reverseArray(nums, 0);\\n            return;\\n        }\\n\\n         for (int i = nums.length - 1; i > idx; i--) {\\n            if (nums[i] > nums[idx]) {\\n                swap(i, idx, nums);\\n                break;\\n            }\\n        }\\n\\n        reverseArray(nums, idx+1);\\n    }\\n    public static void swap(int i, int j, int []arr){\\n            int temp=arr[i];\\n            arr[i]=arr[j];\\n            arr[j]=temp;\\n    }\\n\\n\\n    public static int[] reverseArray(int arr[], int start){\\n        int i=start;\\n        int j=arr.length-1;\\n        while(i<=j){\\n            int temp=arr[i];\\n            arr[i]=arr[j];\\n            arr[j]=temp;\\n            i++;\\n            j--;\\n        }\\n        return arr;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"next-permutation","has_notes":false,"flag_type":1,"frontend_id":123},{"id":2111432289,"question_id":2271,"lang":"java","lang_name":"Java","time":"1\xc2\xa0week, 4\xc2\xa0days","timestamp":1787058338,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/2111432289/","is_pending":"Not Pending","title":"Rearrange Array Elements by Sign","memory":"175.6 MB","code":"class Solution {\\n    public int[] rearrangeArray(int[] nums) {\\n        int[] res = new int[nums.length];\\n        int pos=0, neg=1;\\n        for(int i=0;i<nums.length;i++){\\n            if(nums[i]<0){\\n                res[neg]=nums[i];\\n                neg+=2;\\n            }else{\\n                res[pos]=nums[i];\\n                pos+=2;\\n            }\\n        }\\n        return res;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"rearrange-array-elements-by-sign","has_notes":false,"flag_type":1,"frontend_id":122},{"id":2110143406,"question_id":121,"lang":"java","lang_name":"Java","time":"1\xc2\xa0week, 5\xc2\xa0days","timestamp":1786971680,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2110143406/","is_pending":"Not Pending","title":"Best Time to Buy and Sell Stock","memory":"94.6 MB","code":"class Solution {\\n    public int maxProfit(int[] prices) {\\n        int buy=prices[0];\\n        int profit=0;\\n        for(int i=0;i<prices.length;i++){\\n            int cost = prices[i]-buy;\\n            profit=Math.max(profit, cost);\\n            buy = Math.min(prices[i], buy);\\n\\n        }\\n        return profit;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111