Parentheses","memory":"43.3 MB","code":"class Solution {\\n    public boolean isValid(String s) {\\n         Stack<Character> stack = new Stack<>();\\n\\n        for (char ch : s.toCharArray()) {\\n\\n            if (ch == \'(\' || ch == \'{\' || ch == \'[\') {\\n                stack.push(ch);\\n            } else {\\n\\n                if (stack.isEmpty()) {\\n                    return false;\\n                }\\n\\n                char top = stack.pop();\\n\\n                if ((ch == \')\' && top != \'(\') ||\\n                    (ch == \'}\' && top != \'{\') ||\\n                    (ch == \']\' && top != \'[\')) {\\n                    return false;\\n                }\\n            }\\n        }\\n\\n        return stack.isEmpty();\\n        \\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"valid-parentheses","has_notes":false,"flag_type":1,"frontend_id":104},{"id":2091556458,"question_id":909,"lang":"java","lang_name":"Java","time":"3\xc2\xa0weeks, 6\xc2\xa0days","timestamp":1785685382,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2091556458/","is_pending":"Not Pending","title":"Stone Game","memory":"42.7 MB","code":"class Solution {\\n    public boolean stoneGame(int[] piles) {\\n        return true; \\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111","title_slug":"stone-game","has_notes":false,"flag_type":1,"frontend_id":103},{"id":2091551384,"question_id":342,"lang":"java","lang_name":"Java","time":"3\xc2\xa0weeks, 6\xc2\xa0days","timestamp":1785685113,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2091551384/","is_pending":"Not Pending","title":"Power of Four","memory":"42.3 MB","code":"class Solution {\\n    public boolean isPowerOfFour(int n) {\\n    \\n        if(powerOfFour(n)){return true;}\\n\\n        return false;\\n        \\n    }\\n    public static boolean powerOfFour(int n){\\n        if(n==0){\\n            return false;\\n        }\\n        if(n==1){\\n            return true;\\n        }\\n        if(n%4!=0){\\n            return false;\\n        }\\n\\n        return powerOfFour(n/4);\\n    }\\n}","compare_result":"","title_slug":"power-of-four","has_notes":false,"flag_type":1,"frontend_id":102},{"id":2089983131,"question_id":326,"lang":"java","lang_name":"Java","time":"4\xc2\xa0weeks","timestamp":1785590451,"status":10,"status_display":"Accepted","runtime":"8 ms","url":"/submissions/detail/2089983131/","is_pending":"Not Pending","title":"Power of Three","memory":"46 MB","code":"class Solution {\\n    public boolean isPowerOfThree(int n) {\\n    boolean bool = powerOfThree(n);\\n        if(bool){return true;}\\n\\n        return false;\\n        \\n    }\\n    public static boolean powerOfThree(int n){\\n        if(n==0){\\n            return false;\\n        }\\n        if(n==1){\\n            return true;\\n        }\\n        if(n%3!=0){\\n            return false;\\n        }\\n\\n        return powerOfThree(n/3);\\n    }\\n}","compare_result":"","title_slug":"power-of-three","has_notes":false,"flag_type":1,"frontend_id":101},{"id":2088815999,"question_id":231,"lang":"java","lang_name":"Java","time":"4\xc2\xa0weeks, 1\xc2\xa0day","timestamp":1785503002,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2088815999/","is_pending":"Not Pending","title":"Power of Two","memory":"42.6 MB","code":"class Solution {\\n    public boolean isPowerOfTwo(int n) {\\n        boolean bool = powerOfTwo(n);\\n        if(bool){return true;}\\n\\n        return false;\\n        \\n    }\\n    public static boolean powerOfTwo(int n){\\n        if(n==0){\\n            return false;\\n        }\\n        if(n==1){\\n            return true;\\n        }\\n        if(n%2!=0){\\n            return false;\\n        }\\n\\n        return powerOfTwo(n/2);\\n    }\\n}","compare_result":"